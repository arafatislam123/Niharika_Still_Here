{
  "name": "still-here",
  "private": true,
  "version": "0.1.0",
  "description": "STILL HERE: letters from the machines we left behind. NASA Space Apps 2026.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit -p tsconfig.json && vite build && size-limit",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "fact-register": "tsx scripts/fact-register.ts",
    "teacher-pdfs": "tsx scripts/build-teacher-pdfs.ts",
    "optimize": "tsx scripts/optimize-assets.ts",
    "postinstall": "node scripts/copy-decoders.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@size-limit/file": "^11.1.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "meshoptimizer": "^0.21.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "size-limit": "^11.1.6",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
